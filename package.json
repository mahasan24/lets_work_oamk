{
  "name": "lets_work",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/bun": "^1.3.4",
      "better-auth": "1.6.9",
      "next-themes": "^0.4.6",
      "stripe": "^22.1.1",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @lets_work/db db:push",
    "db:studio": "turbo -F @lets_work/db db:studio",
    "db:generate": "turbo -F @lets_work/db db:generate",
    "db:migrate": "turbo -F @lets_work/db db:migrate"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@lets_work/env": "workspace:*",
    "dotenv": "catalog:",
    "stripe": "^22.1.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lets_work/config": "workspace:*",
    "@types/bun": "catalog:",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "prettier": "3.9.6",
    "turbo": "^2.8.12",
    "typescript": "catalog:",
    "typescript-eslint": "8.65.0"
  },
  "packageManager": "bun@1.3.3"
}
